{
  "name": "bug-bounty-anything",
  "version": "2.0.0",
  "type": "module",
  "description": "Local, evidence-backed vulnerability investigation lab",
  "license": "MIT",
  "author": "Matias Ezequiel Dante Sarco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasdante/bug-bounty-anything.git"
  },
  "homepage": "https://github.com/matiasdante/bug-bounty-anything#readme",
  "bugs": {
    "url": "https://github.com/matiasdante/bug-bounty-anything/issues"
  },
  "keywords": ["bug-bounty", "security-research", "mcp", "cli"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bba": "node src/cli.ts",
    "demo:core": "node src/demo-core.ts",
    "build": "node scripts/build.ts",
    "package:skill": "node scripts/package-skill.ts",
    "check": "tsc --project tsconfig.json",
    "verify": "npm run check && npm run build && npm test",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=2 test/*.test.ts"
  },
  "bin": {
    "bba": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "SKILL.es.md",
    "LICENSE",
    "docs",
    "references",
    "agents",
    "cases"
  ],
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
